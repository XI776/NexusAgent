# Copy this file to .env and set the model credentials before starting.
ANTHROPIC_API_KEY=replace-with-your-api-key
ANTHROPIC_MODEL=replace-with-a-supported-model
# Leave empty for the Anthropic default API, or set a compatible endpoint.
ANTHROPIC_BASE_URL=

APP_ENV=production
LOG_LEVEL=INFO
NEXUSAGENT_ENV=development

# Local demo password used by Redis in docker compose.
REDIS_PASSWORD=local-demo-password
CHROMA_HOST=chromadb
CHROMA_PORT=8000
CHROMA_PERSIST_DIRECTORY=/app/data/chroma

# Optional integrations. Disabled by default for a self-contained demo.
MCP_EXTERNAL_ENABLED=false
INTENT_EMBEDDING_PROVIDER=auto
SILICONFLOW_API_KEY=
ALERT_WEBHOOK_URL=

# For public deployment, set NEXUSAGENT_ENV=production and provide a JSON
# mapping of random API tokens to user_id and role in NEXUSAGENT_API_TOKENS.
